/*
 * CM211-1（厂商 u-boot chainload 的 u-boot.ext）的默认环境变量，经 CONFIG_ENV_SOURCE_FILE="cm211-1" 补在 meson64.h 的 CFG_EXTRA_ENV_SETTINGS 之后。从不保存：环境只在本镜像里（ENV_IS_NOWHERE），不读写任何存储。
 *
 * 启动顺序（U 盘 > 网络 > eMMC）：preboot 先取有线地址（先 DHCP，不应答时用静态地址）并探测服务器（cm211_probe），服务器应答才开网络控制台与 2 s 可打断的倒计时，远程可以在扫 U 盘之前打断、改走别的来源；然后 bootcmd（cm211_boot）扫 U 盘上的 /cm211-1/boot.scr，有就执行；再（仅当主机应答）有界 TFTP 取 cm211-1/<mac>/boot.scr（按实例的覆盖，<mac> 是 ethaddr 转成小写连字符）或 cm211-1/boot.scr；再找 eMMC p1 的 /cm211-1/boot.scr；三级设备目录入口都没有时再退一步读 eMMC p1 根目录的 uEnv.txt 直接 booti eMMC 根（旧式兜底，见 boot_emmc_legacy，避免 U 盘入口坏、eMMC 一级空时无限复位）；都没有才打印一行停在提示符，BOOT_RETRY 到点后复位。
 * 入口只认设备目录 cm211-1/ 下的 boot.scr：随手插着的别的盘（根目录有别的设备的 boot.scr、EFI 可移动介质）不会被当成启动盘，一块盘或一个 TFTP 根能同时放几种型号。distro boot 的变量（meson64.h 的 BOOTENV）还在环境里，只给提示符下手工用，bootcmd 不走它。
 * 每一级执行入口脚本时按 distro boot 的约定设 devtype、devnum、distro_bootpart、prefix（hush 局部变量，与 distro boot 的写法相同，脚本在两种 u-boot 下看到的变量语义一致），另设 cm211_src = usb、tftp 或 emmc，入口脚本把它写成内核参数 cm211.boot_source，部署验收据此核对这次从哪一级来源启动。扫描循环的变量取 scan_dev、scan_part，不与入口脚本自己的循环变量同名（旧 hush 的循环变量是全局的，脚本返回后外层循环会读到被改过的值）。脚本返回（没有 booti 走）后清掉 bootargs，免得带给下一级。
 */

/*
 * 有线地址与服务器（preboot 的第一步，AGENTS.md#host-static-service-address；照 CM201-2 的 patches/u-boot/0015–0017）：先有界 DHCP，服务器取应答给的地址（BOOTP 头的 siaddr，即 DHCP 服务器配的 next-server；不读 option 66）；应答没给时取所得网段的 .2（cm211_srv2，只在地址落在 192.168.1–99.x 时才有），否则不设服务器；DHCP 不应答时用静态地址 cm211_static_ip、服务器 cm211_static_server。“没给”包括 siaddr 为 0 与 siaddr 等于 DHCP 服务器标识（option 54，net/bootp.c 导出为 dhcpserverip）两种：dnsmasq 不配 next-server 时把 siaddr 填成它自己，那多半是只开了 DHCP 的路由器，没有 TFTP。
 * 静态地址是设备自身的配置：本机 192.168.1.11、服务器 192.168.1.2（与 CM201-2 的 u-boot 阶段共用主机侧的 .2；本机取 .11，不与 CM201-2 的 .10、.249 冲突）。默认环境里不放 ipaddr、serverip，运行时由 cm211_net 设；主机工具要 u-boot 阶段的静态地址时读 cm211_static_ip、cm211_static_server。
 * 时长（AGENTS.md#network-boot-probe：链路起来之后 DHCP、ARP 加取第一个启动件合计最长 5 s）：autoload=no 只取参数、不顺带 TFTP。bootpretryperiod 不是硬上限，只在每次重发到期时比一次已用时长；重发间隔从 250 ms 起倍增、缺省封顶 60 s，所以把封顶 bootpretransmitperiodmax 压到 500 ms，0.25 s 之后每约 0.5 s 重发一次，到 3.6 s 之后的那次到期放弃，实际放弃在 3.6–4.15 s 之间（每次间隔另有 ±10% 随机）。这样容得下 dnsmasq 给没有租约、也没有 dhcp-host 登记的新地址先 ping 约 3 s 再发的 OFFER（U-Boot 重发沿用第一个 DISCOVER 的 xid，照收）；DHCP 与服务器都不在时，加上 ping 的 ARP 约 0.8 s 合计 4.4–4.95 s。已知边界：收到 OFFER 后等 ACK 固定 5 s，ACK 丢了会超出预算；dnsmasq 的 ping 等待在繁忙时会拖长，OFFER 晚于放弃时刻就回落静态地址，赶在放弃前一刻（最晚约 4.15 s）到、给出的服务器与 .2 又都不通时这一级最长约 5.75 s。
 * dhcp 一开始就把内部的本机地址清成 0，失败时 setenv ipaddr 经 env 回调把它设回静态地址（覆盖写同样触发回调）。网段判别与 .2 都用 setexpr 的正则替换（不匹配时 setexpr 照样成功、原样写回，所以判别看替换结果是不是 ok）；setexpr 写 env 走程序内接口、不触发 env 回调，网络栈不认，所以 .2 先算进 cm211_srv2，再经 setenv 写进 serverip。
 */
cm211_static_ip=192.168.1.11
cm211_static_server=192.168.1.2
netmask=255.255.255.0
autoload=no
bootpretryperiod=3600
bootpretransmitperiodmax=500
cm211_net=setenv serverip; setenv dhcpserverip; setenv cm211_srv2; if dhcp; then setenv cm211_netsrc dhcp; setexpr cm211_seg sub '^192[.]168[.][1-9][0-9]?[.][0-9]+$' ok ${ipaddr}; if test "${cm211_seg}" = ok; then setexpr cm211_srv2 sub '[.][0-9]+$' .2 ${ipaddr}; fi; if test "${serverip}" = "${dhcpserverip}"; then setenv serverip; fi; if test -z "${serverip}"; then setenv serverip ${cm211_srv2}; fi; else setenv cm211_netsrc static; setenv ipaddr ${cm211_static_ip}; setenv netmask 255.255.255.0; setenv serverip ${cm211_static_server}; fi

/*
 * 主机探测（preboot）：先取地址（cm211_net），再 ping 服务器决定本次启动用不用网络；应答给的服务器 ping 不通时再试所得网段的 .2（AGENTS.md#host-static-service-address 的“取不到时回落 .2”），通了就改用它。ARP 每 ARP_TIMEOUT（200 ms）到期重发一次，计数到 NET_RETRY_COUNT（5）即放弃（net/arp.c，第一次请求计 1），约 0.8 s；对方答 ARP 不答 ping（.2 上恰好是不相干的设备；给出的 next-server 不在本网段又不在，ping 经 DHCP 给的网关发出、网关答 ARP）时 ping 缺省要等满 10 s（net/ping.c），探测里把 pingtimeout 设成 1 s、探测完删掉，别处的 ping 照旧。
 * 链路（AGENTS.md#network-boot-probe 的“等链路有上限，到上限还没起来就跳过”）：内部 PHY 从复位起自协商约 2 s，第一条网络命令（dhcp）最多等 PHY_ANEG_TIMEOUT（3 s），到点链路还没起来就失败（依赖 net/eth-uclass.c 的 eth_init 把网卡 start 的错误返回出来：v2026.10 取 eth_errno 会报成功、让 dhcp 与 ping 白等满超时，上游 59068d48177 已修、进了 v2027.01，本序列 0009 回移）；之后把 phy_aneg_timeout 置 0（genphy_update_link 按它等自协商：链路已经起来时不等，没起来时约 50 ms 就失败），探测里的 ping 不再把 3 s 等第二遍，探测完删掉它，后面的网络命令照常按 3 s；ping 时 meson_gxl 若判出自协商异常（LPA corruption）而重启自协商，也只有约 50 ms，这一次按主机不在处理（U 盘照常），真机待验。已知边界：dhcp 那一步遇到 LPA corruption 时 meson_gxl_startup 最多重启自协商 10 次、每次按 PHY_ANEG_TIMEOUT 等，最坏约 33 s。所以网线未插时这一级约 3 s；探不到服务器就不再碰网络：倒计时降为 0、不试 TFTP。
 * 服务器应答时（cm211_up）网络控制台发往它（ncip 跟随 serverip；u-boot 只收来自 ncip 的输入，经网络控制台打断也要从这个地址发），第一行报出这次的地址来源（dhcp 或 static）、MAC、本机地址与服务器，接收端凭它认出是哪台盒子、走了哪条路、u-boot 此刻的地址；之后 2 s 可打断的倒计时与 TFTP 一级。主机侧接收：tools/netconsole 的常驻服务（UDP 6666），交互用 netconsole.py attach。
 */
cm211_up=setenv host_up 1; setenv ncip ${serverip}; setenv stdout serial,nc; setenv stderr serial,nc; setenv stdin serial,nc; echo CM211-1: net ${cm211_netsrc} ${ethaddr} ${ipaddr} -> ${serverip}
cm211_probe=run cm211_net; setenv phy_aneg_timeout 0; setenv pingtimeout 1000; if test -n "${serverip}" && ping ${serverip}; then run cm211_up; elif test -n "${cm211_srv2}" && test "${cm211_srv2}" != "${serverip}" && ping ${cm211_srv2}; then setenv serverip ${cm211_srv2}; run cm211_up; else setenv host_up; setenv bootdelay 0; fi; setenv phy_aneg_timeout; setenv pingtimeout

/* 设备目录（设备 slug），U 盘、TFTP、eMMC 三级同一相对布局 */
cm211_prefix=cm211-1/

/*
 * U 盘（AGENTS.md#boot-media-order）：按设备编号逐个扫 USB 存储设备（读卡器的每个卡槽各占一个编号），每个设备按分区表的顺序逐个分区找 /cm211-1/boot.scr（part list 列出的全部分区，不写死分区号，介质上可以另有数据分区或原始启动区；没有分区表的整盘介质按分区 0 即整盘找），找到第一个就用，同一轮不再执行后面的；文件系统由通用 fs 层探测，读 FAT（FAT12/16/32，长文件名）、ext4、exFAT（配置增量开 FS_EXFAT）。扫完一遍**没找到过入口文件**、且 usb 0 仍有存储时才 usb reset 再扫一遍：软重启不给 U 盘断电，复位前 U 盘若还在写，Bulk-Only 一端可能卡住、读不出分区表，重新枚举即恢复（CM201-2 实测，devices/media-boxes/cm201-2/patches/u-boot/0011）。scan_found 记录本轮是否找到过入口文件——找到过就不重扫，否则 boot.scr 会在同一次启动里被 source 第二遍、记一条假 LASTHANG 并可能把 usb_panic 置 0（docs/09 §10.12）。插着没有入口的数据盘时多约 1–2 s。扫完停掉 USB。
 * scriptaddr（0x08000000）沿用 meson64.h：source 先把脚本拷进 malloc 的缓冲再执行，之后往 fdt_addr_r（0x08008000）载入 DTB 不影响正在执行的脚本。
 */
boot_usb_scan=setenv scan_found; for scan_dev in 0 1 2 3 4 5 6 7; do if usb dev ${scan_dev}; then setenv scan_parts; part list usb ${scan_dev} scan_parts; env exists scan_parts || setenv scan_parts 0; for scan_part in ${scan_parts}; do if test -z "${scan_found}" && test -e usb ${scan_dev}:${scan_part} /${cm211_prefix}boot.scr; then setenv scan_found 1; run boot_usb_script; fi; done; fi; done
boot_usb=usb start; run boot_usb_scan; if test -z "${scan_found}" && usb dev 0; then echo CM211-1: no bootable USB entry, usb reset and rescan; usb reset; run boot_usb_scan; fi; usb stop
boot_usb_script=echo CM211-1: USB ${scan_dev}:${scan_part} /${cm211_prefix}boot.scr; devtype=usb; devnum=${scan_dev}; distro_bootpart=${scan_part}; prefix=/${cm211_prefix}; cm211_src=usb; if load usb ${scan_dev}:${scan_part} ${scriptaddr} ${prefix}boot.scr; then source ${scriptaddr}; fi; cm211_src=; setenv bootargs

/*
 * 网络（仅当服务器应答）：有界 TFTP（服务器是 cm211_probe 定下的 serverip），先取按实例的覆盖 cm211-1/<mac>/boot.scr（<mac> 是 ethaddr 用小写连字符分隔，setexpr gsub : - 转得，如 32-0b-e7-c3-b0-26），没有再取 cm211-1/boot.scr。传输失败后不重新开始（netretry=no），每次超时 2 s、最多连续五次超时；服务端回 not found 时立即失败。服务器应答 ping 而 TFTP 不应答时每个文件约 12 s、这一级两个文件约 24 s（主机回的 ICMP 端口不可达不缩短等待：处理它的代码只在开了 CMD_TFTPPUT 时编译）；AGENTS.md#network-boot-probe 的前提是主机侧服务已经起好，这是已知边界。文件名转连字符是因为 TFTP 根常是 FAT、文件名不许冒号；net_parse_bootfile（net/net.c）只在冒号前能解析成 IPv4 时才把冒号当“服务器:文件名”拆开，MAC 段不是 IP 本不会误拆，这里仍写 ${serverip}: 前缀，冒号前是合法 IP、被拆成服务器地址、余下当文件名。
 */
netretry=no
tftptimeout=2000
tftptimeoutcountmax=5
tftpblocksize=1468
boot_net_file=if tftpboot ${scriptaddr} ${serverip}:${net_file}; then echo CM211-1: TFTP ${serverip}:${net_file}; devtype=tftp; devnum=; distro_bootpart=; prefix=${net_dir}; cm211_src=tftp; source ${scriptaddr}; cm211_src=; setenv bootargs; fi
boot_net=setenv cm211_mac ${ethaddr}; setexpr cm211_mac gsub : -; net_dir=${cm211_prefix}${cm211_mac}/; net_file=${net_dir}boot.scr; run boot_net_file; net_dir=${cm211_prefix}; net_file=${net_dir}boot.scr; run boot_net_file

/* eMMC：mmc 1 是 eMMC（别名见 cm211-1-u-boot.dtsi），只认 p1 的 /cm211-1/boot.scr */
boot_emmc=if mmc dev 1 && test -e mmc 1:1 /${cm211_prefix}boot.scr; then echo CM211-1: eMMC 1:1 /${cm211_prefix}boot.scr; devtype=mmc; devnum=1; distro_bootpart=1; prefix=/${cm211_prefix}; cm211_src=emmc; if load mmc 1:1 ${scriptaddr} ${prefix}boot.scr; then source ${scriptaddr}; fi; cm211_src=; setenv bootargs; fi

/* eMMC 旧式兜底（docs/09 §10.12，T25）：三级设备目录入口（U 盘 /cm211-1/boot.scr、TFTP、eMMC p1 的 /cm211-1/boot.scr）都没起来时，读 eMMC p1 根目录的 uEnv.txt（eMMC 根自己的 Armbian 布局，不经设备目录入口），用其中的 LINUX/INITRD/FDT/APPEND 加 mac= 直接 booti eMMC 根的内核，内核参数记 cm211.boot_source=emmc。这是 U 盘入口坏掉、eMMC 一级又为空时唯一的出路，否则会停在提示符、BOOT_RETRY 到点复位后从头再来、无限循环。这条路 mainline 读 eMMC 大文件的可靠性未上机验证。软重启后走到这里会起 eMMC p1 的 6.18，大概率挂到用户断电：按设备文档的分档属无拆挡（断电重插即可脱离，之后按残留标记回 U 盘根），不是拔盘可恢复那一挡。读不出 uEnv.txt 时打一行原因、不导入（load 失败时 filesize 是上一次加载留下的过期值），与 booti 失败一样回到提示符。*/
boot_emmc_legacy=if mmc dev 1 && test -e mmc 1:1 uEnv.txt; then echo CM211-1: eMMC 1:1 uEnv.txt (legacy eMMC fallback); if load mmc 1:1 ${loadaddr} uEnv.txt; then env import -t ${loadaddr} ${filesize}; setenv bootargs ${APPEND}; if printenv mac; then setenv bootargs "${bootargs} mac=${mac}"; elif printenv eth_mac; then setenv bootargs "${bootargs} mac=${eth_mac}"; elif printenv ethaddr; then setenv bootargs "${bootargs} mac=${ethaddr}"; fi; setenv bootargs "${bootargs} panic=10"; devtype=mmc; devnum=1; distro_bootpart=1; prefix=/; cm211_src=emmc; setenv bootargs "${bootargs} cm211.boot_source=${cm211_src}"; if load mmc 1:1 ${kernel_addr_r} ${LINUX}; then if load mmc 1:1 ${ramdisk_addr_r} ${INITRD}; then if load mmc 1:1 ${fdt_addr_r} ${FDT}; then fdt addr ${fdt_addr_r}; booti ${kernel_addr_r} ${ramdisk_addr_r} ${fdt_addr_r}; fi; fi; fi; echo "CM211-1: legacy eMMC booti failed; staying at the prompt"; else echo "CM211-1: cannot read eMMC 1:1 uEnv.txt; staying at the prompt"; fi; cm211_src=; setenv bootargs; fi

cm211_boot=run boot_usb; if test -n "${host_up}"; then run boot_net; fi; run boot_emmc; run boot_emmc_legacy; echo CM211-1: no boot entry on USB, network or eMMC, staying at the prompt until BOOT_RETRY resets
