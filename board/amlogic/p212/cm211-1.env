/*
 * CM211-1（厂商 u-boot chainload 的 u-boot.ext）的默认环境变量，经 CONFIG_ENV_SOURCE_FILE="cm211-1" 补在 meson64.h 的 CFG_EXTRA_ENV_SETTINGS 之后。从不保存：环境只在本镜像里（ENV_IS_NOWHERE），不读写任何存储。
 *
 * 启动顺序（U 盘 > 网络 > eMMC）：preboot 先探测主机（cm211_probe），主机应答才开网络控制台与 2 s 可打断的倒计时，远程可以在扫 U 盘之前打断、改走别的来源；然后 bootcmd（cm211_boot）扫 U 盘上的 /cm211-1/boot.scr，有就执行；再（仅当主机应答）有界 TFTP 取 cm211-1/<ethaddr>/boot.scr（按实例的覆盖）或 cm211-1/boot.scr；再找 eMMC p1 的 /cm211-1/boot.scr；都没有就打印一行停在提示符，BOOT_RETRY 到点后复位。
 * 入口只认设备目录 cm211-1/ 下的 boot.scr：随手插着的别的盘（根目录有别的设备的 boot.scr、EFI 可移动介质）不会被当成启动盘，一块盘或一个 TFTP 根能同时放几种型号。distro boot 的变量（meson64.h 的 BOOTENV）还在环境里，只给提示符下手工用，bootcmd 不走它。
 * 每一级执行入口脚本时按 distro boot 的约定设 devtype、devnum、distro_bootpart、prefix（hush 局部变量，与 distro boot 的写法相同，脚本在两种 u-boot 下看到的变量语义一致），另设 cm211_src = usb、tftp 或 emmc，入口脚本把它写成内核参数 cm211.boot_source，部署验收据此核对这次从哪一级来源启动。扫描循环的变量取 scan_dev、scan_part，不与入口脚本自己的循环变量同名（旧 hush 的循环变量是全局的，脚本返回后外层循环会读到被改过的值）。脚本返回（没有 booti 走）后清掉 bootargs，免得带给下一级。
 */

/*
 * 主机探测（preboot）只用一次 ping：ARP 每 ARP_TIMEOUT（200 ms）重发、NET_RETRY_COUNT（5）次后放弃；内部 PHY 从复位起自协商约 2 s，链路没起来时最多等 PHY_ANEG_TIMEOUT（3 s）。所以主机不在时这一级约 1–4 s（网线插着约 1–3 s），此后不再碰网络：倒计时降为 0、不试 TFTP。主机应答时打开网络控制台（输入输出都经 UDP 6666，送往 ncip），倒计时 2 s。
 * 地址是 u-boot 阶段专用的静态配置，与 CM201-2 的 u-boot 阶段共用主机侧的 192.168.1.2（tools/tftpd 的 cm201-2 实例在实验网网卡上自管这个地址）；本机取 192.168.1.11，不与 CM201-2 的 .10、.249 冲突。主机侧接收：tools/netconsole 的常驻服务（UDP 6666），交互用 netconsole.py attach。
 */
ipaddr=192.168.1.11
netmask=255.255.255.0
serverip=192.168.1.2
ncip=192.168.1.2
cm211_probe=if ping ${serverip}; then setenv host_up 1; setenv stdout serial,nc; setenv stderr serial,nc; setenv stdin serial,nc; else setenv host_up; setenv bootdelay 0; fi

/* 设备目录（设备 slug），U 盘、TFTP、eMMC 三级同一相对布局 */
cm211_prefix=cm211-1/

/*
 * U 盘：扫全部 USB 存储设备（读卡器的每个卡槽各占一个编号）的前四个分区，只认 /cm211-1/boot.scr。扫到存储（usb dev 0 成功）却没有起来时 usb reset 再扫一遍：软重启不给 U 盘断电，复位前 U 盘若还在写，Bulk-Only 一端可能卡住、读不出分区表，重新枚举即恢复（CM201-2 实测，devices/media-boxes/cm201-2/patches/u-boot/0011）；插着没有入口的数据盘时多约 1–2 s。扫完停掉 USB。
 * scriptaddr（0x08000000）沿用 meson64.h：source 先把脚本拷进 malloc 的缓冲再执行，之后往 fdt_addr_r（0x08008000）载入 DTB 不影响正在执行的脚本。
 */
boot_usb_scan=for scan_dev in 0 1 2 3 4 5 6 7; do if usb dev ${scan_dev}; then for scan_part in 1 2 3 4; do if test -e usb ${scan_dev}:${scan_part} /${cm211_prefix}boot.scr; then run boot_usb_script; fi; done; fi; done
boot_usb=usb start; run boot_usb_scan; if usb dev 0; then echo CM211-1: no bootable USB entry, usb reset and rescan; usb reset; run boot_usb_scan; fi; usb stop
boot_usb_script=echo CM211-1: USB ${scan_dev}:${scan_part} /${cm211_prefix}boot.scr; devtype=usb; devnum=${scan_dev}; distro_bootpart=${scan_part}; prefix=/${cm211_prefix}; cm211_src=usb; if load usb ${scan_dev}:${scan_part} ${scriptaddr} ${prefix}boot.scr; then source ${scriptaddr}; fi; cm211_src=; setenv bootargs

/*
 * 网络（仅当主机应答）：有界 TFTP，先取按实例的覆盖 cm211-1/<ethaddr>/boot.scr，没有再取 cm211-1/boot.scr。传输失败后不重新开始（netretry=no），每次超时 2 s、最多连续五次超时；服务端回 not found 时立即失败。文件名前写明 ${serverip}:，免得 ethaddr 里的冒号被当成“服务器:文件名”的分隔符。
 */
netretry=no
tftptimeout=2000
tftptimeoutcountmax=5
tftpblocksize=1468
boot_net_file=if tftpboot ${scriptaddr} ${serverip}:${net_file}; then echo CM211-1: TFTP ${serverip}:${net_file}; devtype=tftp; devnum=; distro_bootpart=; prefix=${net_dir}; cm211_src=tftp; source ${scriptaddr}; cm211_src=; setenv bootargs; fi
boot_net=net_dir=${cm211_prefix}${ethaddr}/; net_file=${net_dir}boot.scr; run boot_net_file; net_dir=${cm211_prefix}; net_file=${net_dir}boot.scr; run boot_net_file

/* eMMC：mmc 1 是 eMMC（别名见 cm211-1-u-boot.dtsi），只认 p1 的 /cm211-1/boot.scr */
boot_emmc=if mmc dev 1 && test -e mmc 1:1 /${cm211_prefix}boot.scr; then echo CM211-1: eMMC 1:1 /${cm211_prefix}boot.scr; devtype=mmc; devnum=1; distro_bootpart=1; prefix=/${cm211_prefix}; cm211_src=emmc; if load mmc 1:1 ${scriptaddr} ${prefix}boot.scr; then source ${scriptaddr}; fi; cm211_src=; setenv bootargs; fi

cm211_boot=run boot_usb; if test -n "${host_up}"; then run boot_net; fi; run boot_emmc; echo CM211-1: no boot entry on USB, network or eMMC, staying at the prompt until BOOT_RETRY resets
