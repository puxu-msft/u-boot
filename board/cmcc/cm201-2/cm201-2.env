/*
 * CM201-2 的默认环境变量。从不保存：环境变量只存在于本镜像（ENV_IS_NOWHERE），eMMC 上的 env 分区属于先运行的厂商 fastboot。
 *
 * 启动顺序（U 盘 > 网络 > eMMC）：preboot 先探测主机（主机在时开 netconsole 与可打断的倒计时，远程可以在 U 盘之前打断）；然后扫 U 盘上的 /cm201-2/boot.scr，有就执行；再（仅当主机应答）经 TFTP 取同一布局的启动脚本（cm201-2/<mac>/boot.scr，没有再取 cm201-2/boot.scr）执行，脚本再取同目录的 FIT（kernel + DTB，sha256 哈希）；然后从 raw eMMC 扇区读同一个 FIT；最后 PSCI 复位。FIT 自带 DTB，其 /chosen/bootargs 就是内核命令行：这里刻意不设 bootargs，因为 fdt_chosen() 会用它覆盖 DTB 里的值（U 盘上的启动脚本要换命令行时自己 setenv bootargs）。
 */

/* 与厂商 fastboot 在这个网络上用的地址相同。 */
ipaddr=192.168.1.10
netmask=255.255.255.0
serverip=192.168.1.2
/* 即内核 DT 的 local-mac-address：fdt_fixup_ethernet() 会把 ethaddr 复制进 ethernet0，所以两者必须是同一个地址。 */
ethaddr=02:ca:20:12:00:01

/*
 * 有界 TFTP，仅在探测找到主机后尝试：传输失败后不重新开始，每次超时 2 s，最多连续六次超时：对 TFTP 端口关闭的主机每取一个文件约耗 12 s（主机回的 ICMP 端口不可达不缩短等待，处理它的代码只在开了 CMD_TFTPPUT 时编译），boot_net 先后试两个目录，合计约 24 s；主机不在时探测不通，不碰网络。
 * 窗口 16（RFC 7440）：服务端连发 16 块，客户端每个窗口回一次 ACK，不再每块等一次往返；26 MB 的 FIT 从锁步约 4.5 s 降到约 2.5 s，同一次启动里实测零重传，窗口 8 约 2.7 s。
 */
netretry=no
tftptimeout=2000
tftptimeoutcountmax=5
tftpblocksize=1468
tftpwindowsize=16

fit_addr=0x10000000
/* p6 起始于扇区 0x7000；FIT 位于分区内 4 MiB 处，最长 36 MiB。 */
fit_emmc_sector=0x9000
fit_emmc_count=0x12000

/* 主机探测（preboot）：一次 ping 决定本次启动用不用网络。ARP 每隔 ARP_TIMEOUT（200 ms）重试、四次后放弃，PHY 最多等 PHY_ANEG_TIMEOUT（1 s）链路，因此主机不在或网线未插只多花约 1 s，此后没有任何步骤再等网络：autoboot 倒计时降为 0，并跳过 TFTP。主机应答时启用 netconsole、2 s 倒计时（可经 netconsole 打断）和 TFTP 拉取。主机侧监听命令：socat -u udp-recv:6666 - */
ncip=192.168.1.2
cm201_probe=if ping ${serverip}; then setenv host_up 1; setenv stdout serial,nc; setenv stderr serial,nc; setenv stdin serial,nc; else setenv host_up; setenv bootdelay 0; fi

/*
 * U 盘：只认 /cm201-2/boot.scr（mkimage -T script 的脚本镜像），按设备分目录，随手插着的数据盘不会被当成启动盘。扫全部 USB 存储设备（读卡器的每个卡槽各占一个编号）的前四个分区，文件系统 FAT 或 ext4 均可。脚本执行时 env 里有 distro boot 约定的 devtype、devnum、distro_bootpart 与 prefix，可以用它们从同一分区加载 FIT（例：load ${devtype} ${devnum}:${distro_bootpart} ${fit_addr} ${prefix}cm201-2.itb）。脚本返回（没有 bootm 走）就继续扫下一个，扫完停掉 USB，接着走网络与 eMMC。
 * 循环变量用 usbdev、usbpart，不与写进 env 的 devnum、distro_bootpart 同名：旧 hush 取 ${名} 时先查 env、后查循环变量（common/cli_hush.c lookup_param），同名时第一次 setenv 之后循环变量就被 env 盖住，返回的脚本会被同一个设备号与分区号反复执行。脚本返回后清掉 bootargs：脚本为自己的内核设的命令行不能带给接下来的网络与 eMMC 回落（fdt_chosen 会用它覆盖 DTB 里的）。
 * scriptaddr 在 FIT（fit_addr 起）之下、内核落点（0x08000000 起）之上。
 */
usb_prefix=/cm201-2/
scriptaddr=0x0ff00000
/*
 * 热复位不给读卡器断电（本板 VBUS 不受 EHCI 端口电源位控制）：复位前读卡器若还在往卡里写，它的 Bulk-Only 一端会卡住——设备能枚举、控制端点正常，但 REQUEST SENSE 收不到、CBW 发不出，读不出分区表（usb_storage 的 BBB 复位只做类复位加 clear halt，没做注释里说的端口复位）。卡住后 usb reset 重新枚举就恢复（cm201-2 docs/04-ROOTFS.md §5.1：卡住 7/7 经 usb reset 读到分区表与入口）。所以扫到 USB 存储（usb dev 0 成功）却没起成时 usb reset 再扫一遍：有入口的正常启动不多花时间，插着没有入口的数据盘多约 1.2 s，卡住时约 57 s 后仍从 U 盘起，不再落回网络与 eMMC。
 */
boot_usb_scan=for usbdev in 0 1 2 3 4 5 6 7; do if usb dev ${usbdev}; then for usbpart in 1 2 3 4; do if test -e usb ${usbdev}:${usbpart} ${usb_prefix}boot.scr; then run boot_usb_script; fi; done; fi; done
boot_usb=usb start; run boot_usb_scan; if usb dev 0; then echo CM201-2: no bootable USB entry, usb reset and rescan; usb reset; run boot_usb_scan; fi; usb stop
boot_usb_script=echo CM201-2: USB ${usbdev}:${usbpart} ${usb_prefix}boot.scr; setenv devtype usb; setenv devnum ${usbdev}; setenv distro_bootpart ${usbpart}; setenv prefix ${usb_prefix}; load usb ${usbdev}:${usbpart} ${scriptaddr} ${prefix}boot.scr && source ${scriptaddr}; setenv bootargs

/*
 * 网络：与 U 盘同一布局（AGENTS §4：U 盘与 TFTP 的启动路径按型号分目录、相对布局一致，同一棵目录树既能拷进 U 盘也能交给 tftpd），TFTP 根下 cm201-2/boot.scr 与它旁边的 cm201-2.itb；型号之下可放按实例的覆盖 cm201-2/<mac>/（<mac> 是 ethaddr 把冒号换成连字符，如 02-ca-20-12-00-01：FAT 文件名不许冒号；setexpr gsub 不改大小写，结果是小写是因为默认环境里的 ethaddr 本来就是小写、只写一次），先查覆盖、没有再回落型号目录。
 * 取到脚本就设 devtype=net、prefix=所在目录再 source：脚本（tools/boot-d/mk-boot-scr.py 生成）按 devtype 选 tftpboot 或 load 取同目录的 FIT，开头核对型号。取不到时 tftpd 回 File not found，U-Boot 不重试（net/tftp.c 对 File not found 打 "Not retrying..."），约 20 ms 后就试下一个；tftpd 不应答时要等满上面的超时。脚本返回后清掉 bootargs，理由同 U 盘。netdir 是 env 变量，不用 for 循环，免得循环变量与 env 同名（见上）。
 */
net_prefix=cm201-2/
boot_net=setenv cm201_mac ${ethaddr}; setexpr cm201_mac gsub : -; setenv netdir ${net_prefix}${cm201_mac}/; run boot_net_try; setenv netdir ${net_prefix}; run boot_net_try
boot_net_try=if tftpboot ${scriptaddr} ${netdir}boot.scr; then echo CM201-2: TFTP ${netdir}boot.scr; setenv devtype net; setenv prefix ${netdir}; source ${scriptaddr}; setenv bootargs; fi
boot_emmc=mmc dev 0 && mmc read ${fit_addr} ${fit_emmc_sector} ${fit_emmc_count} && bootm ${fit_addr}
cm201_boot=run boot_usb; if test -n "${host_up}"; then run boot_net; fi; run boot_emmc; echo CM201-2: no bootable FIT, resetting; reset
