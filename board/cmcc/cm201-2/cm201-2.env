/*
 * CM201-2 的默认环境变量。从不保存：环境变量只存在于本镜像（ENV_IS_NOWHERE），eMMC 上的 env 分区属于先运行的厂商 fastboot。
 *
 * 启动顺序：先探测主机，然后（仅当主机应答）一次有界的 FIT TFTP 拉取（kernel + DTB，sha256 哈希），然后从 raw eMMC 扇区读同一个 FIT，最后 PSCI 复位。FIT 自带 DTB，其 /chosen/bootargs 就是内核命令行：这里刻意不设 bootargs，因为 fdt_chosen() 会用它覆盖 DTB 里的值。
 */

/* 与厂商 fastboot 在这个网络上用的地址相同。 */
ipaddr=192.168.1.10
netmask=255.255.255.0
serverip=192.168.1.2
/* 即内核 DT 的 local-mac-address：fdt_fixup_ethernet() 会把 ethaddr 复制进 ethernet0，所以两者必须是同一个地址。 */
ethaddr=02:ca:20:12:00:01

/* 有界 TFTP，仅在探测找到主机后尝试：传输失败后不重新开始，每次超时 2 s，最多连续六次超时，对 TFTP 端口关闭的主机约耗 12 s。 */
netretry=no
tftptimeout=2000
tftptimeoutcountmax=5
tftpblocksize=1468

fit_addr=0x10000000
fit_file=cm201-2.itb
/* p6 起始于扇区 0x7000；FIT 位于分区内 4 MiB 处，最长 36 MiB。 */
fit_emmc_sector=0x9000
fit_emmc_count=0x12000

/* 主机探测（preboot）：一次 ping 决定本次启动用不用网络。ARP 每隔 ARP_TIMEOUT（200 ms）重试、四次后放弃，PHY 最多等 PHY_ANEG_TIMEOUT（1 s）链路，因此主机不在或网线未插只多花约 1 s，此后没有任何步骤再等网络：autoboot 倒计时降为 0，并跳过 TFTP。主机应答时启用 netconsole、2 s 倒计时（可经 netconsole 打断）和 TFTP 拉取。主机侧监听命令：socat -u udp-recv:6666 - */
ncip=192.168.1.2
cm201_probe=if ping ${serverip}; then setenv host_up 1; setenv stdout serial,nc; setenv stderr serial,nc; setenv stdin serial,nc; else setenv host_up; setenv bootdelay 0; fi

boot_net=tftpboot ${fit_addr} ${fit_file} && bootm ${fit_addr}
boot_emmc=mmc dev 0 && mmc read ${fit_addr} ${fit_emmc_sector} ${fit_emmc_count} && bootm ${fit_addr}
cm201_boot=if test -n "${host_up}"; then run boot_net; fi; run boot_emmc; echo CM201-2: no bootable FIT, resetting; reset
