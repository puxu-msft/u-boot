// SPDX-License-Identifier: GPL-2.0
/*
 * 中国移动 CM201-2（Sunnovo 版），Hi3798MV300 机顶盒：1 GiB DDR3、8 GiB eMMC，内置 FE PHY 上单个 100 Mbit 网口。
 *
 * U-Boot 在这里是上游 TF-A BL31 的 BL33，BL31 由厂商 fastboot 经其 FIP 路径启动；BL31 常驻 EL3 并提供 PSCI。U-Boot 没有这个 SoC 的 CRG 时钟驱动，因此 U-Boot 驱动的各模块用固定时钟描述，其速率由板级文件写入 CRG（board/cmcc/cm201-2/cm201-2.c）。
 */

/dts-v1/;

#include "hi3798mv200.dtsi"

/ {
	model = "CM201-2 Hi3798MV300 TV box";
	compatible = "hisilicon,hi3798mv300-tvbox", "hisilicon,hi3798mv200";

	aliases {
		serial0 = &uart0;
		mmc0 = &emmc;
		ethernet0 = &femac;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	memory@0 {
		device_type = "memory";
		reg = <0x0 0x0 0x0 0x40000000>;
	};

	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		/* TF-A BL31，整个运行期间常驻 EL3，提供 PSCI。 */
		bl31@4400000 {
			reg = <0x0 0x04400000 0x0 0x00014000>;
			no-map;
		};
	};
};

&emmc {
	fifo-depth = <256>;
	non-removable;
	bus-width = <8>;
	status = "okay";
};

&soc {
	femac: ethernet@9c30000 {
		compatible = "hisilicon,hi3798mv200-femac";
		reg = <0x9c30000 0x1000>, <0x9c31300 0x200>;
		reg-names = "port", "glb";
		#address-cells = <1>;
		#size-cells = <1>;
		ranges = <0x0 0x9c30000 0x10000>;
		phy-handle = <&fephy>;
		phy-connection-type = "mii";
		hisilicon,phy-reset-delays-us = <10000 10000 500000>;
		status = "okay";

		mdio@1100 {
			compatible = "hisilicon,hisi-femac-mdio";
			reg = <0x1100 0x20>;
			#address-cells = <1>;
			#size-cells = <0>;

			/* 本板内置 FE PHY 在 MDIO 地址 2 应答。 */
			fephy: ethernet-phy@2 {
				reg = <2>;
			};
		};
	};
};

&uart0 {
	status = "okay";
};
