serverip=192.168.21.2
tftpdstp=6969
ncip=192.168.21.2
ncoutport=6666
ncinport=6666
ipaddr=192.168.21.7
netmask=255.255.255.0
gatewayip=192.168.21.1
ethaddr=b4:ba:12:5c:41:a0
bootdelay=1
bootretry=5
bootlimit=3
recovery=0
loadaddr=0x82000000
bootfile=gs2107/boot.scr
bootargs_base=console=ttyS0,115200
ethlinkrequired=1
bootcmd=run gs_boot
altbootcmd=run gs_fallback
gs_boot=if test "${recovery}" = "1"; then run gs_recovery; else run gs_usb_boot; run gs_net_boot; run gs_nand_boot; fi
gs_net_boot=setenv ipaddr 192.168.21.7; setenv netmask 255.255.255.0; setenv gatewayip 192.168.21.1; setenv serverip 192.168.21.2; setenv tftpdstp 6969; setenv autoload no; setenv ncip 192.168.21.2; setenv ncoutport 6666; setenv tftptimeout 1000; setenv tftptimeoutcountmax 1; setenv arpretrycount 15; if tftpboot ${loadaddr} ${serverip}:${bootfile}; then setenv arpretrycount; setenv gs_linkwaitms ${ethlinkwaitms}; setenv gs_stdout ${stdout}; setenv stdout ${gs_stdout},nc; setenv stderr ${gs_stdout},nc; echo "GS2107 network boot: ${serverip}:${bootfile} fetched, link wait ${gs_linkwaitms} ms, gphy ${gphysetup}"; setenv tftptimeout 5000; setenv tftptimeoutcountmax 10; source ${loadaddr}; setenv stdout ${gs_stdout}; setenv stderr ${gs_stdout}; setenv gs_stdout; fi; setenv tftptimeout 5000; setenv tftptimeoutcountmax 10; setenv arpretrycount
gs_usb_boot=usb start; setenv gs_usbdone; for gs_usbdev in 0 1 2 3 4 5 6; do if test -z "${gs_usbdone}"; then run gs_usb_scan; fi; done; setenv gs_usbdone
gs_usb_scan=setenv gs_usbparts; if part list usb ${gs_usbdev} gs_usbparts; then env exists gs_usbparts || setenv gs_usbparts 0; for gs_usbpart in ${gs_usbparts}; do if test -z "${gs_usbdone}" && load usb ${gs_usbdev}:${gs_usbpart} ${loadaddr} gs2107/boot.scr; then setenv gs_usbdone 1; source ${loadaddr}; fi; done; fi; setenv gs_usbparts
gs_nand_boot=if mtd read kernel ${loadaddr}; then setenv bootargs "${bootargs_base} watchdog.open_timeout=120"; bootm ${loadaddr}; fi
gs_fallback=bootcount reset; setenv bootcount; if test "${recovery}" != "1"; then setenv recovery 1; saveenv; fi; run gs_boot
gs_recovery=echo "GS2107 rescue order: network, USB, NAND"; run gs_net_boot; run gs_usb_boot; run gs_nand_boot
